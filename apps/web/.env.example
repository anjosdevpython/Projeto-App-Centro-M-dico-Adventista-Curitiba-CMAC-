# Integração SOUL MV (MV Sistemas) — Ambiente de Produção & Homologação

# URL base da API Portaria / Recepção (conforme Swagger):
NEXT_PUBLIC_SOULMV_API_URL=https://soulmv-sigrah.pbh.gov.br/mv-api-portaria

# Definir como 'false' quando a API estiver liberada e ativa na rede da clínica:
NEXT_PUBLIC_SOULMV_USE_MOCK=true

# Token de autenticação Bearer emitido pela equipe de infraestrutura da MV:
SOULMV_APP_TOKEN=

# Segredo de cliente / API Key da instituição:
SOULMV_CLIENT_SECRET=
